"\x1b[?1049h"  enable DEC private mode (alternate screen buffer with cursor save)
"\x1b[?25l"  disable DEC private mode (cursor visibility)
"\x1b[H"  cursor position (params=[])
"\x1b[2J"  erase in display (params=[2])
"\x1b]0;vim README.md\a"  OSC (operating system command) ("\x1b]0;vim README.md\a")
"\x1b[1;1H"  cursor position (params=[1 1])
"\x1b[38;5;208m"  select graphic rendition (SGR) (foreground color 208 (256-color))
"\x1b[1m"  select graphic rendition (SGR) (bold)
"\x1b[0m"  select graphic rendition (SGR) (reset)
"\x1b[?25h"  enable DEC private mode (cursor visibility)
"\x1b[?25l"  disable DEC private mode (cursor visibility)
"\x1b[24;1H"  cursor position (params=[24 1])
"\x1b[0m"  select graphic rendition (SGR) (reset)
"\x1b[?25h"  enable DEC private mode (cursor visibility)
"\x1b[?1049l"  disable DEC private mode (alternate screen buffer with cursor save)
